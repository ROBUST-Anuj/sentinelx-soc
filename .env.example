# Environment Configuration for SentinelX SOC Platform
PROJECT_NAME="SentinelX SOC Platform"
ENVIRONMENT="production"
SECRET_KEY="sentinelx_soc_super_secret_jwt_signing_key_for_btech_major_project_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# In Docker Compose, the database service host is "sentinelx-db"
DATABASE_URL="sqlite+aiosqlite:///./sentinelx.db"
