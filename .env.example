# ====================================================================
# SentinelX SOC Platform - Production & Environment Variables Template
# ====================================================================
# Copy this file to .env and supply actual deployment values.
# NEVER commit the real .env file or production secrets to Git!

# ----------------- ENVIRONMENT & SECURITY -----------------
# Options: development, staging, production
ENVIRONMENT=production

# Cryptographically secure random secret key (minimum 32 bytes)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_cryptographically_secure_random_string_32_chars_min

# Token lifetime in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ----------------- DATABASE CONFIGURATION -----------------
# For Cloud PostgreSQL (Supabase, Neon, or RDS):
# Use postgresql+asyncpg:// for async and postgresql:// for sync.
# (SentinelX will auto-convert postgres:// or postgresql:// to asyncpg for async pooling)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?ssl=require
SYNC_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require

# For Local Development SQLite (Default):
# DATABASE_URL=sqlite+aiosqlite:///./data/sentinelx.db
# SYNC_DATABASE_URL=sqlite:///./data/sentinelx.db

# ----------------- CORS & FRONTEND ORIGINS -----------------
# Comma-separated list of allowed frontend origins in production
# Example: https://sentinelx-soc.vercel.app,https://yourdomain.com
CORS_ORIGINS=https://sentinelx-soc.vercel.app,http://localhost:3000

# ----------------- FRONTEND CONFIGURATION -----------------
# Set on Vercel or in frontend/.env.production:
# VITE_API_BASE_URL=https://sentinelx-backend.onrender.com/api
# VITE_DEMO_PRESETS=false
